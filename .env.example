# Copy this file to `.env` and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
# `.env` is git-ignored. NEVER put a real key in this example file.

# ---------- Runtime ----------
# dev | test | prod   (test relaxes the "API key required" check)
APP_ENV=dev
LOG_LEVEL=INFO
# false = pretty colours for humans; true = one JSON object per line for machines
LOG_JSON=false

# ---------- Model provider ----------
# openai | azure_openai | gemini | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Cheap models everywhere by default. Change one line to test a stronger one.
CHAT_MODEL=gpt-4o-mini
ANSWER_MODEL=gpt-4o-mini
# The judge is a different model family on purpose, so it does not share the
# generator's blind spots. Used only by the evaluation milestone.
JUDGE_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
# provider = call the API; local = free sentence-transformers model (added in Milestone 2)
EMBEDDING_BACKEND=provider

# Cache identical model calls on disk. Keep this on: it removes most of the
# cost of re-running things while you learn. Clear it with: policydesk cache-clear
LLM_CACHE_ENABLED=true

# ---------- Safety and cost limits (enforced from Milestone 3 onward) ----------
MAX_INPUT_CHARS=4000
# Checked locally before a call is sent, so a runaway prompt costs nothing.
MAX_PROMPT_TOKENS=12000
RETRIEVAL_TOP_K=5
MAX_GRAPH_LOOPS=2
REQUEST_TIMEOUT_S=30
SQL_ROW_LIMIT=200
# Stops a single run that goes over this much model spend. A seatbelt for our
# own code - the real hard cap is the monthly usage limit in your OpenAI account.
MAX_SPEND_USD_PER_RUN=1.00

# ---------- Chunking ----------
# section = one chunk per numbered policy rule (recommended for this corpus)
# fixed   = split every N characters with overlap
CHUNK_STRATEGY=section
CHUNK_SIZE_CHARS=900
CHUNK_OVERLAP_CHARS=150

# ---------- Observability (optional; added in Milestone 8) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
