# --- Secrets: the single most important line in this file ---
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Evaluation runs are a RECORD, not regenerable state: a score from a
# configuration you have since changed cannot be recreated. Committed on purpose.
!eval-runs/

# Generated data (regenerable from scripts; never commit indexes or DBs)
data/processed/
data/raw/*
!data/raw/.gitkeep

# Your own study answers and self-scores. Yours, not the project's --
# the contrast with eval-runs/ (committed) is deliberate: that measures the
# SYSTEM, this records YOU.
study-progress.json
study-progress.tmp

# The icon and launcher ARE committed: they are small, reproducible, and part
# of the project. `policydesk install-shortcut` regenerates them identically.

# OS / editor
Thumbs.db
.DS_Store
.vscode/
